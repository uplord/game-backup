# Firebase web application settings (Firebase Console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Server credentials: use GOOGLE_APPLICATION_CREDENTIALS pointing to a local service-account JSON
# or Application Default Credentials in hosting. NEVER expose this file to the browser.
GOOGLE_APPLICATION_CREDENTIALS=
# Comma-separated Firebase Auth UIDs allowed to access this admin site
ADMIN_UIDS=
